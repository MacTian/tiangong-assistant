.quote-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  margin: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.quote-content {
  position: relative;
  padding: 0 20rpx;
}

.quote-mark {
  font-size: 60rpx;
  color: #bdc3c7;
  font-family: Georgia, serif;
  line-height: 1;
}

.quote-mark.left {
  position: absolute;
  top: -10rpx;
  left: -10rpx;
}

.quote-mark.right {
  position: absolute;
  bottom: -30rpx;
  right: -10rpx;
}

.quote-text {
  display: block;
  font-size: 36rpx;
  line-height: 1.8;
  color: #2c3e50;
  text-align: center;
  padding: 20rpx 30rpx;
}

.quote-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-top: 30rpx;
  padding-right: 20rpx;
}

.quote-from {
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 6rpx;
}

.quote-author {
  font-size: 26rpx;
  color: #95a5a6;
}

.quote-actions {
  display: flex;
  justify-content: space-around;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 1rpx solid #ecf0f1;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 30rpx;
}

.action-btn .icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.action-btn .label {
  font-size: 22rpx;
  color: #7f8c8d;
}
