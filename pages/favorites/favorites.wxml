<view class="container">
  <!-- 空状态 -->
  <view class="empty" wx:if="{{favorites.length === 0}}">
    <text class="empty-icon">📖</text>
    <text class="empty-text">还没有收藏任何金句</text>
    <text class="empty-hint">去首页发现喜欢的金句吧</text>
    <button class="go-home-btn" bindtap="goHome">去看看</button>
  </view>

  <!-- 收藏列表 -->
  <view class="favorites-list" wx:else>
    <view class="count-badge">
      <text>共收藏 {{favorites.length}} 条金句</text>
    </view>

    <view
      class="favorite-item"
      wx:for="{{favorites}}"
      wx:key="savedAt"
    >
      <view class="favorite-content">
        <text class="favorite-text">{{item.hitokoto}}</text>
        <view class="favorite-meta" wx:if="{{item.from_who || item.from}}">
          <text class="favorite-from" wx:if="{{item.from}}">《{{item.from}}》</text>
          <text class="favorite-author" wx:if="{{item.from_who}}">— {{item.from_who}}</text>
        </view>
      </view>
      <view class="favorite-actions">
        <view class="action-icon" bindtap="onCopy" data-text="{{item.hitokoto}}">
          <text>📋</text>
        </view>
        <view class="action-icon" bindtap="onRemove" data-hitokoto="{{item.hitokoto}}">
          <text>🗑️</text>
        </view>
      </view>
    </view>

    <!-- 清空全部 -->
    <view class="clear-all" wx:if="{{favorites.length > 0}}">
      <button class="clear-btn" bindtap="onClearAll">清空全部收藏</button>
    </view>
  </view>
</view>
