.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #2c3e50;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-hint {
  font-size: 26rpx;
  color: #95a5a6;
  margin-bottom: 50rpx;
}

.go-home-btn {
  background: #2c3e50;
  color: #fff;
  font-size: 28rpx;
  padding: 16rpx 60rpx;
  border-radius: 40rpx;
  border: none;
}

/* 收藏数量 */
.count-badge {
  text-align: center;
  padding: 10rpx 0 20rpx;
}

.count-badge text {
  font-size: 24rpx;
  color: #95a5a6;
}

/* 收藏列表项 */
.favorite-item {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: flex-start;
}

.favorite-content {
  flex: 1;
  padding-right: 20rpx;
}

.favorite-text {
  font-size: 30rpx;
  line-height: 1.7;
  color: #2c3e50;
  display: block;
}

.favorite-meta {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-top: 16rpx;
}

.favorite-from {
  font-size: 24rpx;
  color: #7f8c8d;
}

.favorite-author {
  font-size: 24rpx;
  color: #95a5a6;
  margin-top: 4rpx;
}

/* 操作按钮 */
.favorite-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.action-icon {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f8f9fa;
  border-radius: 50%;
}

.action-icon text {
  font-size: 28rpx;
}

/* 清空全部 */
.clear-all {
  margin-top: 40rpx;
  text-align: center;
}

.clear-btn {
  background: transparent;
  color: #e74c3c;
  font-size: 26rpx;
  border: 1rpx solid #e74c3c;
  padding: 12rpx 40rpx;
  border-radius: 30rpx;
}
