<view class="container">
  <!-- 顶部装饰 -->
  <view class="header">
    <text class="app-title">天工金句</text>
    <text class="app-subtitle">每日一言，启迪心智</text>
  </view>

  <!-- 加载状态 -->
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">正在获取金句...</text>
  </view>

  <!-- 错误状态 -->
  <view class="error" wx:elif="{{error}}">
    <text class="error-icon">😔</text>
    <text class="error-text">{{error}}</text>
    <button class="retry-btn" bindtap="fetchQuote">重新加载</button>
  </view>

  <!-- 名言卡片 -->
  <block wx:else>
    <quote-card
      content="{{quote.hitokoto}}"
      author="{{quote.from_who}}"
      from="{{quote.from}}"
      bindrefresh="fetchQuote"
      bindfavorite="onFavorite"
      bindshare="onShare"
    />
  </block>

  <!-- 底部提示 -->
  <view class="footer">
    <text class="footer-text">点击卡片下方按钮 · 换一句 / 收藏 / 分享</text>
  </view>
</view>
