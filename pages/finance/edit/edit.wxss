.container {
  min-height: 100vh;
  background: #f5f5f5;
}

.fund-info {
  padding: 30rpx;
  background: #2c3e50;
  text-align: center;
}

.fund-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.fund-code {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 8rpx;
}

.input-card {
  margin: 20rpx;
  padding: 10rpx 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.input-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ecf0f1;
}

.input-row:last-child {
  border-bottom: none;
}

.input-label {
  width: 160rpx;
  font-size: 28rpx;
  color: #2c3e50;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #2c3e50;
}

.preview-card {
  margin: 0 20rpx 20rpx;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.05);
}

.preview-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.preview-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
}

.preview-label {
  font-size: 26rpx;
  color: #7f8c8d;
}

.preview-value {
  font-size: 26rpx;
  color: #2c3e50;
  font-weight: bold;
}

.save-area {
  padding: 40rpx 20rpx;
}

.btn-save {
  height: 88rpx;
  line-height: 88rpx;
  background: #3498db;
  color: #ffffff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}
