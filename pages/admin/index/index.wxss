.container {
  min-height: 100vh;
  background: #f0f2f5;
  padding-bottom: 40rpx;
}

/* 未登录 */
.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.prompt-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.prompt-text {
  font-size: 30rpx;
  color: #7f8c8d;
  margin-bottom: 50rpx;
}

.login-btn {
  background: linear-gradient(135deg, #2c3e50, #3498db);
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 80rpx;
  border-radius: 40rpx;
  border: none;
}

/* 已登录 */
.header {
  background: linear-gradient(135deg, #1a2a3a 0%, #2c3e50 50%, #3498db 100%);
  padding: 60rpx 40rpx 80rpx;
  display: flex;
  flex-direction: column;
}

.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-top: 10rpx;
}

.stats-bar {
  display: flex;
  background: #ffffff;
  margin: -40rpx 30rpx 30rpx;
  border-radius: 20rpx;
  padding: 36rpx 0;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.stat-item + .stat-item::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 1rpx;
  background: #ecf0f1;
}

.stat-num {
  font-size: 44rpx;
  font-weight: bold;
  color: #2c3e50;
}

.stat-num.pending { color: #f39c12; }
.stat-num.active { color: #27ae60; }
.stat-num.revoked { color: #e74c3c; }

.stat-label {
  font-size: 22rpx;
  color: #95a5a6;
  margin-top: 8rpx;
}

.menu-grid {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
}

.menu-item {
  width: 48%;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 32rpx 24rpx;
  margin: 1%;
  box-sizing: border-box;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.menu-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
}

.menu-item:nth-child(1)::before { background: linear-gradient(90deg, #f39c12, #e67e22); }
.menu-item:nth-child(2)::before { background: linear-gradient(90deg, #3498db, #2980b9); }
.menu-item:nth-child(3)::before { background: linear-gradient(90deg, #27ae60, #2ecc71); }
.menu-item:nth-child(4)::before { background: linear-gradient(90deg, #9b59b6, #8e44ad); }
.menu-item:nth-child(5)::before { background: linear-gradient(90deg, #1abc9c, #16a085); }

.menu-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 14rpx;
}

.menu-title {
  display: block;
  font-size: 30rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 6rpx;
}

.menu-desc {
  display: block;
  font-size: 22rpx;
  color: #95a5a6;
}

.logout-section {
  padding: 40rpx 30rpx 20rpx;
}

.logout-btn {
  background: transparent;
  color: #e74c3c;
  font-size: 28rpx;
  border: 1rpx solid #e74c3c;
  border-radius: 40rpx;
  padding: 16rpx 0;
}
