.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.filter-bar {
  display: flex;
  background: #ffffff;
  padding: 16rpx 20rpx;
  gap: 12rpx;
  border-bottom: 1rpx solid #ecf0f1;
}

.filter-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: 26rpx;
  color: #7f8c8d;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.filter-item.active {
  background: #2c3e50;
  color: #ffffff;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #ecf0f1;
  border-top: 4rpx solid #2c3e50;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #7f8c8d;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 200rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #95a5a6;
}

.list {
  padding: 20rpx;
}

.list-header {
  padding: 10rpx 10rpx 20rpx;
}

.list-count {
  font-size: 26rpx;
  color: #7f8c8d;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-bottom: 1rpx solid #ecf0f1;
}

.card-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.card-tag.approved {
  background: #eafaf1;
  color: #27ae60;
}

.card-tag.rejected {
  background: #fdedec;
  color: #e74c3c;
}

.card-tag.expired {
  background: #fef9e7;
  color: #f39c12;
}

.card-time {
  font-size: 22rpx;
  color: #95a5a6;
}

.card-body {
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  margin-bottom: 10rpx;
}

.info-label {
  font-size: 24rpx;
  color: #95a5a6;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #2c3e50;
  flex: 1;
  word-break: break-all;
}

.info-value.code {
  font-weight: bold;
  color: #e67e22;
}

.info-value.mono {
  font-family: monospace;
  font-size: 22rpx;
}
