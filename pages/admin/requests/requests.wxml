<view class="container">
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="empty" wx:elif="{{list.length === 0}}">
    <text class="empty-icon">✅</text>
    <text class="empty-text">暂无待审批请求</text>
    <button class="refresh-btn" bindtap="loadData">刷新</button>
  </view>

  <view class="list" wx:else>
    <view class="list-header">
      <text class="list-count">共 {{list.length}} 条待审批</text>
      <text class="refresh-link" bindtap="loadData">刷新</text>
    </view>

    <view class="card" wx:for="{{list}}" wx:key="RequestCode">
      <view class="card-header">
        <text class="card-tag">{{item.SoftwareId || '未知软件'}}</text>
        <text class="card-time">{{item.requestedAtFormatted}}</text>
      </view>

      <view class="card-body">
        <view class="info-row">
          <text class="info-label">请求码</text>
          <text class="info-value code">{{item.RequestCode}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">设备指纹</text>
          <text class="info-value mono">{{item.DeviceFingerprint}}</text>
        </view>
        <view class="info-row" wx:if="{{item.DeviceInfo}}">
          <text class="info-label">设备信息</text>
          <text class="info-value">{{item.DeviceInfo}}</text>
        </view>
      </view>

      <view class="card-actions">
        <button class="btn-approve" bindtap="onApprove" data-index="{{index}}">批准</button>
        <button class="btn-reject" bindtap="onReject" data-index="{{index}}">拒绝</button>
      </view>
    </view>
  </view>

  <view class="modal-mask" wx:if="{{showModal}}" bindtap="closeModal">
    <view class="modal-content" catchtap="">
      <view class="modal-header">
        <text class="modal-title">批准授权</text>
        <text class="modal-close" bindtap="closeModal">✕</text>
      </view>

      <view class="modal-body">
        <view class="form-group">
          <text class="form-label">授权类型</text>
          <view class="radio-group">
            <view class="radio-item {{licenseType === 0 ? 'active' : ''}}" bindtap="setType" data-type="0">
              <text>临时授权</text>
            </view>
            <view class="radio-item {{licenseType === 1 ? 'active' : ''}}" bindtap="setType" data-type="1">
              <text>永久授权</text>
            </view>
          </view>
        </view>

        <view class="form-group" wx:if="{{licenseType === 0}}">
          <text class="form-label">授权天数</text>
          <view class="radio-group">
            <view class="radio-item {{durationDays === d.value ? 'active' : ''}}"
                  wx:for="{{durationOptions}}" wx:for-item="d" wx:key="value"
                  bindtap="setDuration" data-days="{{d.value}}">
              <text>{{d.label}}</text>
            </view>
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">最大激活设备数</text>
          <input class="form-input" type="number" value="{{maxActivations}}" bindinput="setMaxAct" placeholder="1" />
        </view>

        <view class="form-group">
          <text class="form-label">备注（可选）</text>
          <textarea class="form-textarea" value="{{notes}}" bindinput="setNotes" placeholder="输入备注信息" />
        </view>
      </view>

      <view class="modal-footer">
        <button class="btn-cancel" bindtap="closeModal">取消</button>
        <button class="btn-confirm" bindtap="confirmApprove" loading="{{approving}}">确认批准</button>
      </view>
    </view>
  </view>
</view>
