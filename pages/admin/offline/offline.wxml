<view class="container">
  <!-- 步骤指示器 -->
  <view class="steps">
    <view class="step {{step >= 1 ? 'active' : ''}}">
      <text class="step-num">1</text>
      <text class="step-text">导入指纹</text>
    </view>
    <view class="step-line {{step >= 2 ? 'active' : ''}}"></view>
    <view class="step {{step >= 2 ? 'active' : ''}}">
      <text class="step-num">2</text>
      <text class="step-text">配置授权</text>
    </view>
    <view class="step-line {{step >= 3 ? 'active' : ''}}"></view>
    <view class="step {{step >= 3 ? 'active' : ''}}">
      <text class="step-num">3</text>
      <text class="step-text">生成授权</text>
    </view>
  </view>

  <!-- 步骤1：导入设备指纹文件 -->
  <view class="step-content" wx:if="{{step === 1}}">
    <view class="card">
      <view class="card-title">导入设备指纹文件</view>
      <text class="card-desc">请选择客户端导出的设备指纹 JSON 文件</text>

      <button class="upload-btn" bindtap="chooseFile">
        <text class="upload-icon">📁</text>
        <text>选择文件</text>
      </button>

      <view class="file-info" wx:if="{{fileName}}">
        <text class="file-name">📄 {{fileName}}</text>
      </view>

      <view class="info-preview" wx:if="{{fingerprint}}">
        <view class="info-row">
          <text class="info-label">设备指纹</text>
          <text class="info-value mono">{{fingerprint.deviceFingerprint}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">设备信息</text>
          <text class="info-value">{{fingerprint.deviceInfo}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">软件ID</text>
          <text class="info-value">{{fingerprint.softwareId}}</text>
        </view>
      </view>
    </view>

    <button class="next-btn {{fingerprint ? '' : 'disabled'}}" bindtap="nextStep" disabled="{{!fingerprint}}">
      下一步
    </button>
  </view>

  <!-- 步骤2：配置授权参数 -->
  <view class="step-content" wx:if="{{step === 2}}">
    <view class="card">
      <view class="card-title">配置授权参数</view>

      <view class="form-group">
        <text class="form-label">授权类型</text>
        <view class="radio-group">
          <view class="radio-item {{licenseType === 0 ? 'active' : ''}}" bindtap="setType" data-type="0">
            <text>临时授权</text>
          </view>
          <view class="radio-item {{licenseType === 1 ? 'active' : ''}}" bindtap="setType" data-type="1">
            <text>永久授权</text>
          </view>
        </view>
      </view>

      <view class="form-group" wx:if="{{licenseType === 0}}">
        <text class="form-label">授权天数</text>
        <view class="radio-group">
          <view class="radio-item {{durationDays === d.value ? 'active' : ''}}"
                wx:for="{{durationOptions}}" wx:for-item="d" wx:key="value"
                bindtap="setDuration" data-days="{{d.value}}">
            <text>{{d.label}}</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">最大激活设备数</text>
        <input class="form-input" type="number" value="{{maxActivations}}" bindinput="setMaxAct" placeholder="1" />
      </view>

      <view class="form-group">
        <text class="form-label">离线宽限期（天）</text>
        <input class="form-input" type="number" value="{{offlineGraceDays}}" bindinput="setGraceDays" placeholder="7" />
      </view>

      <view class="form-group">
        <text class="form-label">备注（可选）</text>
        <textarea class="form-textarea" value="{{notes}}" bindinput="setNotes" placeholder="输入备注信息" />
      </view>
    </view>

    <view class="btn-row">
      <button class="prev-btn" bindtap="prevStep">上一步</button>
      <button class="next-btn" bindtap="doOfflineActivate" loading="{{activating}}">生成授权</button>
    </view>
  </view>

  <!-- 步骤3：生成结果 -->
  <view class="step-content" wx:if="{{step === 3}}">
    <view class="result-card success" wx:if="{{licenseResult}}">
      <text class="result-icon">✅</text>
      <text class="result-title">授权生成成功</text>

      <view class="result-info">
        <view class="info-row">
          <text class="info-label">授权码</text>
          <text class="info-value code">{{licenseResult.licenseCode}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">类型</text>
          <text class="info-value">{{licenseResult.type === 0 ? '临时授权' : '永久授权'}}</text>
        </view>
        <view class="info-row" wx:if="{{licenseResult.expiresAt}}">
          <text class="info-label">到期时间</text>
          <text class="info-value">{{licenseResult.expiresAtFormatted}}</text>
        </view>
      </view>

      <view class="license-file-section">
        <text class="section-title">授权文件</text>
        <textarea class="license-text" value="{{licenseFileBase64}}" auto-height="true" disabled="true" />
        <button class="copy-btn" bindtap="copyLicenseFile">复制授权文件</button>
        <button class="share-btn" open-type="share">分享授权文件</button>
      </view>
    </view>

    <view class="result-card error" wx:else>
      <text class="result-icon">❌</text>
      <text class="result-title">授权生成失败</text>
      <text class="result-msg">{{errorMsg}}</text>
    </view>

    <button class="reset-btn" bindtap="reset">重新开始</button>
  </view>
</view>
