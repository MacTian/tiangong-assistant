.container {
  min-height: 100vh;
  background: #f0f2f5;
  padding: 20rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

/* 步骤指示器 */
.steps {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 0 40rpx;
}

.step {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #ecf0f1;
  color: #95a5a6;
  font-size: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.step.active .step-num {
  background: #2c3e50;
  color: #ffffff;
}

.step-text {
  font-size: 22rpx;
  color: #95a5a6;
  margin-top: 8rpx;
}

.step.active .step-text {
  color: #2c3e50;
}

.step-line {
  width: 80rpx;
  height: 4rpx;
  background: #ecf0f1;
  margin: 0 16rpx;
  margin-bottom: 28rpx;
}

.step-line.active {
  background: #2c3e50;
}

/* 步骤内容 */
.step-content {
  padding-bottom: 20rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 26rpx;
  color: #95a5a6;
  margin-bottom: 30rpx;
  display: block;
}

/* 上传按钮 */
.upload-btn {
  width: 100%;
  height: 120rpx;
  background: #f8f9fa;
  border: 2rpx dashed #bdc3c7;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7f8c8d;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.upload-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.file-info {
  padding: 16rpx 20rpx;
  background: #eafaf1;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.file-name {
  font-size: 26rpx;
  color: #27ae60;
}

.info-preview {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
}

.info-row {
  display: flex;
  margin-bottom: 12rpx;
}

.info-label {
  font-size: 24rpx;
  color: #95a5a6;
  width: 140rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 24rpx;
  color: #2c3e50;
  flex: 1;
  word-break: break-all;
}

.info-value.mono {
  font-family: monospace;
  font-size: 22rpx;
}

.info-value.code {
  font-weight: bold;
  color: #e67e22;
  font-family: monospace;
}

/* 表单 */
.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #7f8c8d;
  margin-bottom: 12rpx;
}

.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.radio-item {
  padding: 12rpx 24rpx;
  background: #f8f9fa;
  border: 2rpx solid #ecf0f1;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #555;
}

.radio-item.active {
  background: #ebf5fb;
  border-color: #3498db;
  color: #3498db;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #f8f9fa;
  border: 2rpx solid #ecf0f1;
  border-radius: 8rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  height: 120rpx;
  background: #f8f9fa;
  border: 2rpx solid #ecf0f1;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

/* 按钮 */
.btn-row {
  display: flex;
  gap: 20rpx;
}

.prev-btn {
  flex: 1;
  background: #ecf0f1;
  color: #7f8c8d;
  font-size: 28rpx;
  padding: 18rpx 0;
  border-radius: 10rpx;
  border: none;
}

.next-btn {
  flex: 1;
  background: #2c3e50;
  color: #ffffff;
  font-size: 28rpx;
  padding: 18rpx 0;
  border-radius: 10rpx;
  border: none;
}

.next-btn.disabled {
  background: #bdc3c7;
}

/* 结果页 */
.result-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}

.result-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.result-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #2c3e50;
  display: block;
  margin-bottom: 30rpx;
}

.result-msg {
  font-size: 28rpx;
  color: #e74c3c;
  display: block;
}

.result-info {
  text-align: left;
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
}

.license-file-section {
  text-align: left;
  margin-top: 20rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #2c3e50;
  margin-bottom: 16rpx;
}

.file-info-row {
  display: flex;
  align-items: center;
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 20rpx;
}

.file-info-label {
  font-size: 24rpx;
  color: #95a5a6;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.file-info-value {
  font-size: 24rpx;
  color: #2c3e50;
  font-family: monospace;
}

.license-json {
  width: 100%;
  background: #f8f9fa;
  border: 2rpx solid #ecf0f1;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 20rpx;
  font-family: monospace;
  color: #555;
  max-height: 300rpx;
  overflow-y: auto;
  box-sizing: border-box;
  word-break: break-all;
  margin-bottom: 20rpx;
}

.download-btn {
  width: 100%;
  background: #27ae60;
  color: #fff;
  font-size: 30rpx;
  padding: 20rpx 0;
  border-radius: 10rpx;
  border: none;
}

.reset-btn {
  width: 100%;
  background: transparent;
  color: #7f8c8d;
  font-size: 28rpx;
  border: 1rpx solid #bdc3c7;
  border-radius: 10rpx;
  padding: 16rpx 0;
  margin-top: 30rpx;
}
