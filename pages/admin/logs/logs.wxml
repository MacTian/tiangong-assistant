<view class="container">
  <view class="loading" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
    <text class="loading-text">加载中...</text>
  </view>

  <view class="empty" wx:elif="{{list.length === 0}}">
    <text class="empty-icon">📊</text>
    <text class="empty-text">暂无激活记录</text>
    <button class="refresh-btn" bindtap="loadData">刷新</button>
  </view>

  <view class="list" wx:else>
    <view class="list-header">
      <text class="list-count">共 {{list.length}} 条记录</text>
      <text class="refresh-link" bindtap="loadData">刷新</text>
    </view>

    <view class="card" wx:for="{{list}}" wx:key="Id">
      <view class="card-header">
        <text class="card-code">{{item.LicenseCode || 'N/A'}}</text>
        <text class="card-time">{{item.activatedAtFormatted}}</text>
      </view>

      <view class="card-body">
        <view class="info-row full-width">
          <text class="info-label">设备指纹</text>
          <text class="info-value mono">{{item.DeviceFingerprint}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">IP 地址</text>
          <text class="info-value">{{item.IpAddress || 'N/A'}}</text>
        </view>
        <view class="info-row" wx:if="{{item.LastVerifiedAt}}">
          <text class="info-label">最后验证</text>
          <text class="info-value">{{item.lastVerifiedAtFormatted}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
