/* miniprogram/pages/notes/notes.wxss */
.notebook-card {
  padding: 0;
  overflow: hidden;
}

.notebook-header {
  display: flex;
  align-items: center;
  padding: 16px;
  gap: 8px;
}

.notebook-header:active {
  background: #f9f9f9;
}

.notebook-icon {
  font-size: 20px;
}

.notebook-name {
  flex: 1;
  font-size: 16px;
  font-weight: 600;
}

.notebook-count {
  font-size: 12px;
  color: #999;
}

.expand-icon {
  font-size: 12px;
  color: #999;
}

.sections {
  border-top: 1px solid #f0f0f0;
}

.section-item {
  display: flex;
  align-items: center;
  padding: 12px 16px 12px 44px;
  gap: 8px;
  border-bottom: 1px solid #f5f5f5;
}

.section-item:last-child {
  border-bottom: none;
}

.section-item:active {
  background: #f9f9f9;
}

.section-icon {
  font-size: 16px;
}

.section-name {
  flex: 1;
  font-size: 14px;
}

.section-count {
  font-size: 12px;
  color: #999;
}
